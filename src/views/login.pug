doctype html
html
  head
    title Awesome Gym &mdash; Log in
  body
    h1 Awesome Gym &mdash; Log in
    form(action="/login" method="POST")
      label Email:
        input(type="email" name="email" required)
      br
      label Password:
        input(type="password" name="password" required)
      br
      button(type="submit") Log in
