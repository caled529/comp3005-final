doctype html
html
  head
    title Log in
  body
    h1 Log in
    form(action="/login" method="POST")
      label(for="email") Email:
      input(type="email" name="email" required)
      br
      label(for="password") Password:
      input(type="password" name="password" required)
      br
      button(type="submit") Log in
